{
  "rewrites": [
    { "source": "/sri-yantra", "destination": "/sri-yantra.html" },
    { "source": "/sri-yantra.html", "destination": "/sri-yantra.html" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/|sri-yantra).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Edge-Routing", "value": "Anycast-Global-v4.2" },
        { "key": "X-Load-Balancer", "value": "Abhimanyu-Anycast-Director" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
